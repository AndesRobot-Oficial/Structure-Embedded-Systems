<?xml version="1.0"?>
<!--
  MILO - base (AndesRobot)
  ⚠ MEDIDAS PROVISORIAS: todos los valores de abajo son de ejemplo.
  Reemplazarlos por los del CAD (dimensiones, masas, ubicación de sensores).
  Se asume tracción diferencial con una rueda loca; cambiar si la base es otra.
  Convención REP 103: X adelante, Y izquierda, Z arriba. Unidades SI (m, kg, rad).
-->
<robot name="milo" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find milo_description)/urdf/inertias.xacro"/>

  <!-- ===== Parámetros (PROVISORIOS) ===== -->
  <xacro:property name="base_length"   value="0.50"/>
  <xacro:property name="base_width"    value="0.45"/>
  <xacro:property name="base_height"   value="0.25"/>
  <xacro:property name="base_mass"     value="20.0"/>
  <xacro:property name="base_z"        value="0.05"/>   <!-- altura del fondo del chasis sobre el suelo -->

  <xacro:property name="wheel_radius"  value="0.0826"/> <!-- rueda de hoverboard 6.5" (dato real) -->
  <xacro:property name="wheel_width"   value="0.04"/>
  <xacro:property name="wheel_mass"    value="1.0"/>
  <xacro:property name="wheel_y"       value="0.25"/>   <!-- distancia del centro a cada rueda -->
  <xacro:property name="wheel_x"       value="0.0"/>

  <xacro:property name="caster_radius" value="0.03"/>
  <xacro:property name="caster_mass"   value="0.2"/>
  <xacro:property name="caster_x"      value="-0.20"/>

  <xacro:property name="arm_mount_xyz" value="0.15 0 ${base_height}"/>
  <xacro:property name="arm_mount_rpy" value="0 0 0"/>

  <material name="gris"><color rgba="0.5 0.5 0.5 1"/></material>
  <material name="negro"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="azul"><color rgba="0.1 0.3 0.8 1"/></material>

  <!-- ===== Base ===== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- base_link: centro del eje de las ruedas -->
  <link name="base_link">
    <visual>
      <!-- Reemplazar por: <mesh filename="package://milo_description/meshes/chasis.stl" scale="0.001 0.001 0.001"/> -->
      <origin xyz="0 0 ${base_z - wheel_radius + base_height/2}"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="gris"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_z - wheel_radius + base_height/2}"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}">
      <origin xyz="0 0 ${base_z - wheel_radius + base_height/2}"/>
    </xacro:box_inertia>
  </link>

  <!-- ===== Ruedas ===== -->
  <xacro:macro name="wheel" params="side reflect">
    <link name="${side}_wheel_link">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="negro"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}">
        <origin rpy="${pi/2} 0 0"/>
      </xacro:cylinder_inertia>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="${wheel_x} ${reflect*wheel_y} 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel side="left"  reflect="1"/>
  <xacro:wheel side="right" reflect="-1"/>

  <!-- ===== Rueda loca ===== -->
  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="negro"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}">
      <origin xyz="0 0 0"/>
    </xacro:sphere_inertia>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x} 0 ${caster_radius - wheel_radius}"/>
  </joint>

  <!-- ===== Sensores (posiciones PROVISORIAS) ===== -->
  <xacro:macro name="sensor_frame" params="name xyz rpy size">
    <link name="${name}">
      <visual>
        <geometry><box size="${size}"/></geometry>
        <material name="azul"/>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <xacro:sensor_frame name="laser_link"  xyz="0.20 0 0.20"  rpy="0 0 0" size="0.06 0.06 0.05"/>
  <xacro:sensor_frame name="camera_link" xyz="0.22 0 0.60"  rpy="0 0 0" size="0.03 0.10 0.03"/>
  <xacro:sensor_frame name="imu_link"    xyz="0 0 0.05"     rpy="0 0 0" size="0.02 0.02 0.01"/>

  <!-- ===== Interfaz con el brazo (ver interfaz_brazo/README.md) ===== -->
  <link name="arm_mount_link"/>
  <joint name="arm_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_mount_link"/>
    <origin xyz="${arm_mount_xyz}" rpy="${arm_mount_rpy}"/>
  </joint>

</robot>
