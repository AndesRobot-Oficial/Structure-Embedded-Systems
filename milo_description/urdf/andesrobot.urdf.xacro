    </geometry>
  </collision>
  </xacro:unless>
</link>

<!-- Rueda motriz izquierda (rueda de hoverboard 6.5", radio 0.08255 m). -->
<link name="left_wheel_link_1">
  <inertial>
    <origin xyz="-2.7755575615628914e-17 -0.02249983226177152 8.78772389301119e-08" rpy="0 0 0"/>
    <mass value="3.0"/>
    <inertia ixx="0.00561703" iyy="0.0102205" izz="0.00561703" ixy="-0" iyz="0" ixz="0"/>
  </inertial>
  <visual>
    <origin xyz="-0.13 0.15775 0.520496" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find andesrobot_description)/meshes/left_wheel_link_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <!-- cilindro ideal: r=0.08255, ancho 0.045 (medido de la malla) -->
    <!-- rpy 1.5708 (90°) en x acuesta el cilindro para que su eje quede a lo ancho, como una rueda. -->
    <origin xyz="0 -0.0225 0" rpy="1.5707963267948966 0 0"/>
    <geometry>
      <cylinder radius="0.08255" length="0.045"/>
    </geometry>
  </collision>
</link>

<!-- Rueda motriz derecha. -->
<link name="right_wheel_link_1">
  <inertial>
    <origin xyz="-2.7755575615628914e-17 0.02249983226177152 0.0" rpy="0 0 0"/>
    <mass value="3.0"/>
    <inertia ixx="0.00561703" iyy="0.0102205" izz="0.00561703" ixy="0" iyz="-0" ixz="0"/>
  </inertial>
  <visual>
    <origin xyz="-0.13 -0.15775 0.52" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find andesrobot_description)/meshes/right_wheel_link_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <!-- cilindro ideal: r=0.08255, ancho 0.045 (medido de la malla) -->
    <origin xyz="0 0.0225 0" rpy="1.5707963267948966 0 0"/>
    <geometry>
      <cylinder radius="0.08255" length="0.045"/>
    </geometry>
  </collision>
</link>

<!-- IMU (acelerómetro + giroscopio). -->
<link name="imu_link_1">
  <inertial>
    <origin xyz="0.0 0.0 -0.007499999999999951" rpy="0 0 0"/>
    <mass value="0.0183804"/>
    <inertia ixx="2e-06" iyy="2e-06" izz="4e-06" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.0 0.5" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find andesrobot_description)/meshes/imu_link_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <xacro:unless value="${simple_collision}">
  <collision>
    <origin xyz="-0.0 -0.0 0.5" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find andesrobot_description)/meshes/imu_link_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
  </xacro:unless>
</link>

<!-- Rueda loca delantera. En el CAD venía como un "palo"; se modela como caster giratorio.
     caster_height = montaje -> suelo (del CAD). caster_wheel_radius: MEDIR la rueda real y ajustar. -->
<xacro:property name="caster_height" value="0.103"/>
<xacro:property name="caster_wheel_radius" value="0.025"/>
<xacro:property name="caster_wheel_width" value="0.020"/>
<link name="front_caster_link_1">
  <inertial>
    <origin xyz="0.0 0.0 -0.0515" rpy="0 0 0"/>
    <mass value="0.1"/>
    <inertia ixx="9.45905e-05" iyy="9.45905e-05" izz="1.16618e-05" ixy="0" iyz="0" ixz="0"/>
  </inertial>
  <!-- placa de montaje -->
  <visual>
    <origin xyz="0 0 -0.0025" rpy="0 0 0"/>
    <geometry><box size="0.05 0.05 0.005"/></geometry>
    <material name="caster_black"/>
  </visual>
  <!-- cuerpo / horquilla -->
  <visual>
    <origin xyz="0 0 ${-(caster_height - 2*caster_wheel_radius)/2 - 0.0025}" rpy="0 0 0"/>
    <geometry><cylinder radius="0.012" length="${caster_height - 2*caster_wheel_radius - 0.005}"/></geometry>
    <material name="caster_black"/>
  </visual>
  <!-- rueda -->
  <visual>
    <origin xyz="0 0 ${-(caster_height - caster_wheel_radius)}" rpy="${pi/2} 0 0"/>
    <geometry><cylinder radius="${caster_wheel_radius}" length="${caster_wheel_width}"/></geometry>
    <material name="caster_black"/>
  </visual>
  <!-- colisión: esfera sin fricción (aprox. estándar de rueda loca en Gazebo) -->
  <collision>
    <origin xyz="0 0 ${-(caster_height - caster_wheel_radius)}" rpy="0 0 0"/>
    <geometry><sphere radius="${caster_wheel_radius}"/></geometry>
  </collision>
</link>

<!-- Carcasa del RPLIDAR C1. El frame exacto de medición es "laser" (más abajo). -->
<link name="lidar_link_1">
  <inertial>
    <origin xyz="-0.058000000000000024 -1.9721522630525296e-33 0.02065000000000003" rpy="0 0 0"/>
    <mass value="0.11"/>
    <inertia ixx="4.38916e-05" iyy="4.38916e-05" izz="5.68965e-05" ixy="0" iyz="-0" ixz="0"/>
  </inertial>
  <visual>
    <origin xyz="0.22 -0.0 0.27" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find andesrobot_description)/meshes/lidar_link_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <xacro:unless value="${simple_collision}">
  <collision>
    <origin xyz="0.22 -0.0 0.27" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find andesrobot_description)/meshes/lidar_link_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
  </xacro:unless>
</link>

<!-- Columna vertical (perfil de 1.5 m) por donde sube el carro del elevador. -->
<link name="vertical_column_link_1">
  <inertial>
    <origin xyz="-0.03 0.0 0.75" rpy="0 0 0"/>
    <mass value="4.6"/>
    <inertia ixx="0.86388" iyy="0.86388" izz="0.00275968" ixy="0" iyz="0" ixz="-0"/>
  </inertial>
  <visual>
    <origin xyz="-0.16 -0.0 0.5" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find andesrobot_description)/meshes/vertical_column_link_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <xacro:unless value="${simple_collision}">
  <collision>
    <origin xyz="-0.16 -0.0 0.5" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find andesrobot_description)/meshes/vertical_column_link_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
  </xacro:unless>
</link>

<!-- Base del brazo, atornillada al carro del elevador. -->
<link name="arm_base_link_1">
  <inertial>
    <origin xyz="4.338687172847182e-05 -0.00010909262325140833 0.017247921655867693" rpy="0 0 0"/>
    <mass value="0.97"/>
    <inertia ixx="0.00152928" iyy="0.00153442" izz="0.00285038" ixy="-2.57022e-06" iyz="2.57022e-06" ixz="-0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0075 -0.0 -0.3175" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find andesrobot_description)/meshes/arm_base_link_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <xacro:unless value="${simple_collision}">
  <collision>
    <origin xyz="-0.0075 -0.0 -0.3175" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find andesrobot_description)/meshes/arm_base_link_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
  </xacro:unless>
</link>

<!-- ================================== ARTICULACIONES (joints) ==================================
     Las articulaciones del brazo quedan "continuous" (sin topes) SOLO hasta medir los topes físicos.
     Antes de mover el brazo real (o usar MoveIt), cambiar a "revolute" con límites medidos
     (lower/upper en rad, velocity, effort). Con lock_arm:=true son "fixed". -->
<!-- Brazo 1: gira la base del brazo alrededor de Z (vertical). -->
<joint name="joint_1" type="${arm_joint_type}">
  <!-- Dónde queda el hijo respecto al padre (aquí 3.7 cm más arriba). -->
  <origin xyz="0.0 0.0 0.037" rpy="0 0 0"/>
  <parent link="arm_base_link_1"/>
  <child link="link_1_1"/>
  <!-- Eje de giro (0 0 1 = Z). -->
  <axis xyz="0.0 0.0 1.0"/>
  <!-- Amortiguación y roce de la articulación (solo para la simulación). -->
  <dynamics damping="0.08" friction="0.02"/>
</joint>

<!-- Brazo 2 (hombro): gira alrededor de X. -->
<joint name="joint_2" type="${arm_joint_type}">
  <origin xyz="-0.065 0.0 0.056" rpy="0 0 0"/>
  <parent link="link_1_1"/>
  <child link="link_2_1"/>
  <axis xyz="-1.0 0.0 0.0"/>
  <dynamics damping="0.12" friction="0.03"/>
</joint>

<!-- Brazo 3 (codo): gira alrededor de X. -->
<joint name="joint_3" type="${arm_joint_type}">
  <origin xyz="-0.001077 0.0 0.350077" rpy="0 0 0"/>
  <parent link="link_2_1"/>
  <child link="link_3_1"/>
  <axis xyz="1.0 0.0 0.0"/>
  <dynamics damping="0.12" friction="0.03"/>
</joint>

<!-- Brazo 4 (muñeca): gira alrededor de X. -->
<joint name="joint_4" type="${arm_joint_type}">
  <origin xyz="0.026 0.0 0.3235" rpy="0 0 0"/>
  <parent link="link_3_1"/>
  <child link="link_4_1"/>
  <axis xyz="-1.0 0.0 0.0"/>
  <dynamics damping="0.06" friction="0.02"/>
</joint>

<!-- Brazo 5 (muñeca): gira alrededor de Z. -->
<joint name="joint_5" type="${arm_joint_type}">
  <origin xyz="-0.0495 0.0 0.04" rpy="0 0 0"/>
  <parent link="link_4_1"/>
  <child link="link_5_1"/>
  <axis xyz="0.0 0.0 1.0"/>
  <dynamics damping="0.05" friction="0.02"/>
</joint>

<!-- Brazo 6 (muñeca): gira alrededor de X. -->
<joint name="joint_6" type="${arm_joint_type}">
  <origin xyz="-0.041 0.0 0.0495" rpy="0 0 0"/>
  <parent link="link_5_1"/>
  <child link="link_6_1"/>
  <axis xyz="-1.0 0.0 0.0"/>
  <dynamics damping="0.05" friction="0.02"/>
</joint>

<!-- Dedo derecho: se desliza en Y entre -7 mm y +16 mm. -->
<joint name="right_finger_joint" type="${prismatic_joint_type}">
  <origin xyz="-0.0576 -0.0038 0.0135" rpy="0 0 0"/>
  <parent link="link_6_1"/>
  <child link="right_finger_link_1"/>
  <axis xyz="0.0 1.0 0.0"/>
  <limit upper="0.016" lower="-0.007" effort="30" velocity="0.05"/>
</joint>

<!-- Dedo izquierdo: se desliza en Y; "mimic" lo hace copiar al derecho con signo opuesto (la pinza cierra simétrica). -->
<joint name="left_finger_joint" type="${prismatic_joint_type}">
  <origin xyz="-0.0576 0.0038 -0.0135" rpy="0 0 0"/>
  <parent link="link_6_1"/>
  <child link="left_finger_link_1"/>
  <axis xyz="0.0 1.0 0.0"/>
  <xacro:unless value="${lock_arm}"><mimic joint="right_finger_joint" multiplier="-1.0" offset="0.0"/></xacro:unless>
  <limit upper="0.007" lower="-0.016" effort="30" velocity="0.05"/>
</joint>

<!-- Elevador: el carro sube/baja en Z por la columna, de -0.4 m a +0.6 m. -->
<joint name="vertical_lift_joint" type="${prismatic_joint_type}">
  <origin xyz="-0.06 0.0 0.75" rpy="0 0 0"/>
  <parent link="vertical_column_link_1"/>
  <child link="lift_carriage_link_1"/>
  <axis xyz="0.0 0.0 1.0"/>
  <dynamics damping="5.0" friction="2.0"/>
  <!-- Límites: recorrido en m (lower/upper), fuerza máx. en N (effort), velocidad máx. en m/s. -->
  <limit upper="0.6" lower="-0.4" effort="150" velocity="0.20"/>
</joint>

<!-- Rueda izquierda: gira sin límite. Este nombre lo usan el diff drive simulado y ros2_control. -->
<joint name="left_wheel_joint" type="continuous">
  <origin xyz="0 0.15775 0" rpy="0 0 3.141592653589793"/>
  <parent link="base_link"/>
  <child link="left_wheel_link_1"/>
  <axis xyz="0.0 -1.0 0.0"/>
  <dynamics damping="0.02" friction="0.0"/>
</joint>
<!-- Las dos ruedas: joint con rpy yaw 180° y eje -Y. Girado 180°, el eje -Y queda como +Y:
     velocidad positiva = rueda avanza hacia +X (adelante). -->

<!-- Rueda derecha. -->
<joint name="right_wheel_joint" type="continuous">
  <origin xyz="0 -0.15775 0" rpy="0 0 3.141592653589793"/>
  <parent link="base_link"/>
  <child link="right_wheel_link_1"/>
  <axis xyz="0.0 -1.0 0.0"/>
  <dynamics damping="0.02" friction="0.0"/>
</joint>

<!-- IMU pegada al chasis. -->
<joint name="imu_joint" type="fixed">
  <origin xyz="0.13 0 0.020248" rpy="0 0 3.141592653589793"/>
  <parent link="base_link"/>
  <child link="imu_link_1"/>
</joint>

<!-- Rueda loca pegada al chasis, 0.35 m delante del eje. -->
<joint name="front_caster_joint" type="fixed">
  <origin xyz="0.35 0 0.020248" rpy="0 0 3.141592653589793"/>
  <parent link="base_link"/>
  <child link="front_caster_link_1"/>
</joint>

<!-- Carcasa del lidar pegada al chasis, al frente. -->
<joint name="lidar_joint" type="fixed">
  <origin xyz="0.35 0 0.250248" rpy="0 0 3.141592653589793"/>
  <parent link="base_link"/>
  <child link="lidar_link_1"/>
</joint>

<!-- Columna pegada al chasis, sobre el eje de las ruedas. -->
<joint name="base_to_vertical_column_joint" type="fixed">
  <origin xyz="-0.03 0 0.020248" rpy="0 0 3.141592653589793"/>
  <parent link="base_link"/>
  <child link="vertical_column_link_1"/>
</joint>

<!-- Base del brazo pegada al carro del elevador. -->
<joint name="carriage_to_arm_joint" type="fixed">
  <origin xyz="-0.0925 0.0 0.0675" rpy="0 0 0"/>
  <parent link="lift_carriage_link_1"/>
  <child link="arm_base_link_1"/>
</joint>

<!-- RPLIDAR C1: plano de escaneo ~30 mm sobre la base del sensor, centro del sensor a x=-0.058 en lidar_link_1.
     lidar_link_1 está girado 180° (CAD al revés), por eso yaw=pi aquí: el frame "laser" queda mirando +X del robot.
     Nombre "laser" = frame_id por defecto del driver rplidar_ros, así sirve igual en el robot real
     (en el real ajusta el yaw según cómo quede montado el conector del C1). -->
<link name="laser">
  <!-- masa mínima para que Gazebo Classic no descarte el link -->
  <inertial>
    <mass value="0.001"/>
    <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
  </inertial>
</link>
<joint name="laser_joint" type="fixed">
  <origin xyz="-0.058 0.0 0.030" rpy="0 0 3.141592653589793"/>
  <parent link="lidar_link_1"/>
  <child link="laser"/>
</joint>


<!-- MASAS: estimadas en docs/calculos/masas.md del repo (rev. 0), no salen del CAD.
     Fusion exportó las piezas con un material por defecto, así que las masas del CAD se
     reemplazaron y la inercia de cada link se escaló en la misma proporción.
     base_link incluye chasis, placas, tornillería, electrónica central y cables (10.7 kg);
     la columna incluye el motor del elevador. Reemplazar por pesos reales cuando se midan. -->

<!-- Macro: caja sólida con masa (para baterías y drivers, que no están en el CAD). -->
<xacro:macro name="mass_box" params="name mass sx sy sz xyz">
  <link name="${name}">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass/12*(sy**2 + sz**2)}" ixy="0" ixz="0"
               iyy="${mass/12*(sx**2 + sz**2)}" iyz="0"
               izz="${mass/12*(sx**2 + sy**2)}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${sx} ${sy} ${sz}"/></geometry>
      <material name="caster_black"/>
    </visual>
  </link>
  <joint name="${name}_joint" type="fixed">
    <origin xyz="${xyz}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="${name}"/>
  </joint>
</xacro:macro>

<!-- 2 baterías 10S2P en lo más bajo del chasis (centro a 0.10 m del suelo). -->
<xacro:mass_box name="batteries_link" mass="2.2" sx="0.20" sy="0.16" sz="0.07" xyz="0.13 0 ${0.10 - 0.08255}"/>
<!-- 7 drivers TB6600 sobre la base, hacia atrás (centro a 0.36 m del suelo). -->
<xacro:mass_box name="drivers_link" mass="1.3" sx="0.10" sy="0.40" sz="0.05" xyz="-0.07 0 ${0.36 - 0.08255}"/>

<!-- Simulación (Gazebo): lidar, diff drive, IMU, joint states. Va al final porque usa lock_arm. -->
<!-- (Las etiquetas <gazebo> solo las lee Gazebo; en el robot real se ignoran.) -->
<xacro:include filename="$(find andesrobot_description)/urdf/andesrobot.sim.xacro" />

<!-- Milo físico: ros2_control con el hoverboard -->
<!-- Solo con use_hardware:=true (robot.launch.py). Agrega el bloque <ros2_control> que le dice al
     controller_manager qué driver cargar y qué ruedas maneja. hoverboard_port = puerto serie. -->
<xacro:arg name="use_hardware" default="false"/>
<xacro:arg name="hoverboard_port" default="/dev/hoverboard"/>
<xacro:if value="$(arg use_hardware)">
  <xacro:include filename="$(find andesrobot_description)/urdf/andesrobot.ros2_control.xacro" />
</xacro:if>

</robot>
