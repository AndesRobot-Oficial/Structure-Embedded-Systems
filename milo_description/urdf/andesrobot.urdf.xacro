<!-- Carro del elevador: sube y baja por la columna llevando el brazo. -->
<link name="lift_carriage_link_1">
  <inertial>
    <origin xyz="-0.055357142857138136 -1.5546917979023206e-16 0.03714285714285398" rpy="0 0 0"/>
    <mass value="0.4"/>
    <inertia ixx="0.00292764" iyy="0.00213053" izz="0.00370908" ixy="-0" iyz="-0" ixz="0.000588845"/>
  </inertial>
  <visual>
    <origin xyz="-0.1 -0.0 -0.25" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find andesrobot_description)/meshes/lift_carriage_link_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <xacro:unless value="${simple_collision}">
  <collision>
    <origin xyz="-0.1 -0.0 -0.25" rpy="0 0 0"/>
