<?xml version="1.0" ?>
<robot name="andesrobot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- =============================================================================================
  MODELO DE MILO (URDF + xacro)

  CÓMO SE LEE UN URDF
  - <link>  = una pieza rígida del robot (chasis, rueda, eslabón del brazo...). Puede tener:
      <inertial>  masa, centro de masa (origin) y momentos de inercia (inertia). Lo usa la física
                  (Gazebo). Los valores vienen exportados del CAD de Fusion.
      <visual>    cómo se ve: una malla .stl (scale 0.001 porque el CAD está en mm y ROS usa m)
                  o una forma simple (box, cylinder, sphere).
      <collision> con qué forma choca. Puede ser distinta del visual (más simple = más estable).
  - <joint> = la unión entre dos links: padre -> hijo. Tipos que usamos:
      fixed       pegado, no se mueve (lidar, IMU, columna...)
      continuous  gira sin límite (ruedas, brazo mientras no se midan sus topes)
      prismatic   se desliza en línea recta, con límites (lift, dedos)
    <origin xyz="x y z" rpy="roll pitch yaw"> = dónde queda el hijo respecto al padre
      (metros y radianes; 3.14159 = 180 grados).
    <axis> = alrededor de (o a lo largo de) qué eje se mueve.
  - Todos los links forman un árbol que parte en base_footprint. robot_state_publisher lo
    convierte en TF (las transformadas entre frames).

  POR QUÉ LOS <visual> TIENEN ORIGIN RAROS (ej. xyz="0.13 0 0.520248")
  Fusion exporta cada malla en las coordenadas globales del ensamblaje, no centradas en su pieza.
  El origin del visual/collision corre la malla de vuelta a su lugar dentro del frame del link.

  XACRO (macros sobre URDF; se procesa con el comando "xacro" antes de usarlo)
  - <xacro:arg name="x" default="..."/>   argumento que se pasa desde afuera:  xacro archivo x:=valor
  - $(arg x)                              el valor de ese argumento
  - <xacro:property name="p" value="..."/>  una variable;  ${p} = su valor; ${...} también
                                          evalúa expresiones de Python (ej. ${a * 2}, ${pi/2})
  - <xacro:if value="..."> / <xacro:unless value="...">  incluir el contenido solo si es
                                          verdadero / falso
  - <xacro:include filename="..."/>       pegar aquí otro archivo .xacro
  - $(find paquete)                       ruta a la carpeta instalada de ese paquete
============================================================================================= -->

<!-- Colores (materials) y propiedades físicas para Gazebo (fricción de ruedas). -->
<xacro:include filename="$(find andesrobot_description)/urdf/andesrobot.materials.xacro" />
<xacro:include filename="$(find andesrobot_description)/urdf/andesrobot.gazebo.xacro" />

<!-- lock_arm:=true -> brazo, lift y dedos quedan FIXED (simular/mapear sin que el brazo se desplome).
     Para RViz con sliders: lock_arm:=false (default). -->
<xacro:arg name="lock_arm" default="false"/>
<!-- Convertir el texto "true"/"false" del argumento en un verdadero/falso de Python. -->
<xacro:property name="lock_arm" value="${'$(arg lock_arm)' == 'true'}"/>
<!-- Tipo de articulación del brazo: fixed si lock_arm, si no continuous (gira) / prismatic (desliza). -->
<xacro:property name="arm_joint_type" value="${'fixed' if lock_arm else 'continuous'}"/>
<xacro:property name="prismatic_joint_type" value="${'fixed' if lock_arm else 'prismatic'}"/>

<!-- simple_collision:=true -> la física usa cajas/cilindros en vez de las mallas CAD (estable y rápido en Gazebo).
     Pensado junto con lock_arm:=true (las colisiones del brazo van como una caja fija en base_link). -->
<xacro:arg name="simple_collision" default="false"/>
<xacro:property name="simple_collision" value="${'$(arg simple_collision)' == 'true'}"/>
<!-- Interruptores de sensores simulados (para depurar). Los usa andesrobot.sim.xacro. -->
<xacro:arg name="sim_lidar" default="true"/>
<xacro:arg name="sim_imu" default="true"/>
<!--
  Convención REP-103 / REP-105 (estándar de ROS):
  +X = adelante, +Y = izquierda, +Z = arriba.
  En Fusion el robot se modeló mirando al revés (girado 180° en Z). Por eso varias piezas
  llevan rpy="0 0 3.14159" (giro de 180°) en sus joints/visuales: para dejar todo mirando a +X.
-->
<!-- base_footprint: punto en el suelo, justo bajo el centro del eje de las ruedas motrices.
     Es la raíz del árbol y el frame que usan la odometría, el SLAM y el filtro de seguridad.
     No tiene forma ni masa: es solo un sistema de coordenadas. -->
<link name="base_footprint"/>

<joint name="base_footprint_joint" type="fixed">
  <!-- base_link = centro del eje de las ruedas motrices (centro de rotación del diff drive), a la altura del radio de rueda -->
  <origin xyz="0 0 0.08255" rpy="0 0 0"/>
  <parent link="base_footprint"/>
  <child link="base_link"/>
</joint>

<!-- base_link: el CHASIS (bastidor de aluminio). Su origen está en el centro del eje de ruedas.
     Explico cada parte una vez aquí; los demás links tienen la misma estructura. -->
<link name="base_link">
  <!-- Física: centro de masa (origin), masa en kg e inercia (resistencia a girar) en kg·m². -->
  <inertial>
    <origin xyz="0.12174 0 0.110956" rpy="0 0 0"/>
    <mass value="10.7"/>
    <inertia ixx="0.441167" iyy="0.459156" izz="0.712445" ixy="-0" iyz="1.93312e-06" ixz="-0.00782913"/>
  </inertial>
  <!-- Cómo se ve: la malla del CAD, corrida a su lugar (origin) y escalada de mm a m. -->
  <visual>
    <origin xyz="0.13 0 0.520248" rpy="0 0 3.141592653589793"/>
    <geometry>
      <mesh filename="file://$(find andesrobot_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <!-- Color definido en andesrobot.materials.xacro. -->
    <material name="silver"/>
  </visual>
  <!-- Colisión con la malla CAD completa: solo si simple_collision es falso. -->
  <xacro:unless value="${simple_collision}">
  <collision>
    <origin xyz="0.13 0 0.520248" rpy="0 0 3.141592653589793"/>
    <geometry>
      <mesh filename="file://$(find andesrobot_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
  </xacro:unless>
  <!-- Colisiones simplificadas (medidas de las mallas, en frame base_link) -->
  <!-- En simulación (simple_collision:=true) todo el robot choca como estas 5 formas simples,
       pegadas al chasis (el brazo va fijo). Es mucho más estable para Gazebo que las mallas. -->
  <xacro:if value="${simple_collision}">
    <collision name="chasis">
      <origin xyz="0.13 0 0.115" rpy="0 0 0"/>
      <geometry><box size="0.50 0.50 0.27"/></geometry>
    </collision>
    <collision name="columna">
      <origin xyz="0 0 0.77" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 1.50"/></geometry>
    </collision>
    <collision name="rplidar_c1">
      <origin xyz="0.408 0 0.271" rpy="0 0 0"/>
      <geometry><cylinder radius="0.028" length="0.042"/></geometry>
    </collision>
    <collision name="carro_lift">
      <origin xyz="0.1225 0 0.789" rpy="0 0 0"/>
      <geometry><box size="0.185 0.26 0.172"/></geometry>
    </collision>
    <collision name="brazo">
      <origin xyz="0.221 0 1.3045" rpy="0 0 0"/>
      <geometry><box size="0.308 0.11 0.859"/></geometry>
    </collision>
  </xacro:if>
</link>

<!-- Brazo, eslabón 1: base giratoria del brazo (gira en Z sobre arm_base_link_1). -->
<link name="link_1_1">
  <inertial>
    <origin xyz="-0.01769557352244753 -9.412818198760994e-06 0.06365159642189822" rpy="0 0 0"/>
    <mass value="1.31"/>
    <inertia ixx="0.00326332" iyy="0.00351412" izz="0.00353527" ixy="-0" iyz="0" ixz="-0.000181296"/>
  </inertial>
  <visual>
    <origin xyz="-0.0075 -0.0 -0.3545" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find andesrobot_description)/meshes/link_1_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <xacro:unless value="${simple_collision}">
  <collision>
    <origin xyz="-0.0075 -0.0 -0.3545" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find andesrobot_description)/meshes/link_1_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
  </xacro:unless>
</link>

